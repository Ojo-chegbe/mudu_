{
  "name": "mudu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:host": "node --env-file-if-exists=.env --watch apps/host/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env apps/host/main.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit && node --test tests/*.test.ts",
    "format": "prettier --write apps packages tests scripts docs README.md vite.config.ts tsconfig.json package.json index.html .prettierrc.json",
    "format:check": "prettier --check apps packages tests scripts docs README.md vite.config.ts tsconfig.json package.json index.html .prettierrc.json"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
